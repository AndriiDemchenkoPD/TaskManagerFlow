# Default mode uses local Mailpit SMTP (works out-of-the-box in Docker).
# Mailpit inbox UI: http://localhost:8025
# To use real SMTP (e.g. Gmail), replace values below.

AUTH_RESET_PASSWORD_URL=http://localhost:5173/reset-password

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENABLE_SSL=false
SMTP_FROM=noreply@taskflow.local
SMTP_USERNAME=
SMTP_PASSWORD=
